<mxfile host="app.diagrams.net">
  <diagram id="ip-hostname-resolver" name="IP Hostname Resolver">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Containers -->
        <mxCell id="build" value="Build (daily)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#9aa5b1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#3e4c59;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="960" height="170" as="geometry" />
        </mxCell>
        <mxCell id="use" value="Use (per alert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#9aa5b1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#3e4c59;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="230" width="960" height="150" as="geometry" />
        </mxCell>

        <!-- Build row -->
        <mxCell id="A" value="Authentication datamodel&lt;br&gt;&lt;i&gt;machine accounts (HOST$)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B" value="Scheduled report&lt;br&gt;&lt;i&gt;daily, -25h&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="C" value="ip_hostname_correlation_lookup&lt;br&gt;&lt;i&gt;IpAddress, Hostname&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="D" value="Lookup definition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="770" y="90" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Use row -->
        <mxCell id="E" value="Correlation search&lt;br&gt;&lt;i&gt;event or tstats&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="F" value="&lt;b&gt;ip_hostname_resolver&lt;/b&gt; macro&lt;br&gt;&lt;i&gt;IP ⇄ Hostname, fallback to original&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="G" value="Notable&lt;br&gt;&lt;i&gt;src_resolved / dst_resolved&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="280" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="H" value="Incident Review&lt;br&gt;&lt;i&gt;title + columns&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="770" y="280" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Build edges -->
        <mxCell id="eAB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="A" target="B">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eBC" value="outputlookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="B" target="C">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eCB" value="inputlookup merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="C" target="B">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="55" />
              <mxPoint x="375" y="55" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eCD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="C" target="D">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross edge: definition read by macro -->
        <mxCell id="eDF" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D" target="F">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="865" y="210" />
              <mxPoint x="385" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Use edges -->
        <mxCell id="eEF" value="| `ip_hostname_resolver`" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;fontFamily=Courier New;" edge="1" parent="1" source="E" target="F">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eFG" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="F" target="G">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eGH" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="G" target="H">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
